DB_USER=postgres
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bitescouts_db
FE_HOST=http://localhost:5173

# LLM chatbot — set LLM_PROVIDER to "ollama" or "gemini"
LLM_PROVIDER=ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
LLM_MAX_HISTORY=20

# Session cookie (required). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
COOKIE_SECRET=replace-with-secrets-token-hex-32
# Set true only behind HTTPS in production
COOKIE_SECURE=false

# External places APIs — chatbot gap-fills local DB with these when nearby results are thin
# PLACES_PROVIDER: "serpapi" (default) or "google"
PLACES_PROVIDER=serpapi
SERPAPI_API_KEY=
GOOGLE_PLACES_API_KEY=

# Food date planning
DATE_PLAN_RADIUS_KM=10
DATE_PLAN_TOP_K=5
DATE_PLAN_USE_LLM=true

# Dangerous DB wipe endpoint — keep false unless you intentionally need DELETE /delete
ALLOW_DB_RESET=false
